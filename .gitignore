# ============================================
# Connecting the Dots AI - .gitignore
# ============================================

# ------------------------------
# Python
# ------------------------------

# Virtual environments
venv/
env/
ENV/
.venv
.env/
env.bak/
venv.bak/

# ------------------------------
# Node.js / JavaScript / TypeScript
# ------------------------------

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build output
.next/
out/
build/

# Nuxt.js build output
.nuxt/
dist/

# ------------------------------
# Environment Variables
# ------------------------------

# Environment files
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
.env.prod.local

# Database
*.db
*.sqlite
*.sqlite3
*.pgsql
*.dump
postgres_data/
redis_data/

# ------------------------------
# Sensitive files (never commit)
# ------------------------------

# API keys and secrets
.env
.env.*
!.env.example
secrets.json
credentials.json
config.local.json

# ------------------------------
# Keep these files
# ------------------------------

# Ensure these are tracked (optional)
!.gitkeep
!.dockerignore
!.npmrc

# Example files
!.env.example
!.env.sample
!docker-compose.override.example.yml

# ============================================
# End of .gitignore
# ============================================